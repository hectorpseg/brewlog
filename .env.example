NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-publishable-key-here
# Never expose service-role to the browser. Server-only scripts may use:
# SUPABASE_SERVICE_ROLE_KEY=(only in secure server env, never NEXT_PUBLIC_)
# Dev-only seed switch. Leave unset/empty in production.
# When "true", /coffees shows Seed/Reset demo-data buttons for the signed-in user.
ALLOW_DEV_SEED=
